{
  "expo": {
    "name": "Avi Music",
    "slug": "avi-music",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "web": { "bundler": "metro", "output": "single" },
    "ios": {
      "bundleIdentifier": "com.avimusic.app",
      "infoPlist": { "UIBackgroundModes": ["audio"] }
    },
    "android": {
      "package": "com.avimusic.app",
      "permissions": ["FOREGROUND_SERVICE", "WAKE_LOCK"]
    }
  }
}
