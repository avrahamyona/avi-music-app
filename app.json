{
  "expo": {
    "name": "Avi Music",
    "slug": "avi-music",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/icon.png" },
    "experiments": { "baseUrl": "/avi-music-app" },
    "ios": {
      "bundleIdentifier": "com.avimusic.app",
      "infoPlist": { "UIBackgroundModes": ["audio"] }
    },
    "android": {
      "package": "com.avimusic.app",
      "permissions": ["FOREGROUND_SERVICE", "FOREGROUND_SERVICE_MEDIA_PLAYBACK", "WAKE_LOCK", "POST_NOTIFICATIONS"],
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#fa2d48" }
    }
  }
}
